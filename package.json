{
  "name": "visp-hyper-agent",
  "version": "0.3.0",
  "description": "Deterministic, local-first workflow controller for AI coding tools: scoped edits, evidence-gated checkpoints, and advisory model routing. No LLM calls.",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": [
    "ai",
    "coding-agent",
    "claude-code",
    "codex",
    "copilot",
    "mcp",
    "spec-driven",
    "workflow",
    "git-hooks",
    "llm-memory"
  ],
  "homepage": "https://github.com/djkeshawa/visp-hyper-agent#readme",
  "bugs": {
    "url": "https://github.com/djkeshawa/visp-hyper-agent/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/djkeshawa/visp-hyper-agent.git"
  },
  "bin": {
    "visp-hyper": "dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "examples/quickstart.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "pretest": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.3.0",
  "dependencies": {
    "commander": "^12.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
