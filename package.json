{
  "name": "visp-hyper-agent",
  "version": "0.7.0",
  "description": "Runs the Visp workflow inside Codex, Claude Code, and Copilot. Prepares scoped handoffs and records checkpoint evidence. Makes no LLM calls of its own.",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": [
    "ai",
    "ai-coding",
    "coding-agent",
    "claude-code",
    "codex",
    "copilot",
    "mcp",
    "workflow",
    "git-hooks",
    "evidence",
    "developer-tools"
  ],
  "homepage": "https://github.com/djkeshawa/visp-hyper-agent#readme",
  "bugs": {
    "url": "https://github.com/djkeshawa/visp-hyper-agent/issues"
  },
  "bin": {
    "visp": "dist/index.js",
    "visp-hyper": "dist/index.js"
  },
  "files": [
    "CONTRIBUTING.md",
    "LICENSE",
    "NOTICE",
    "README.md",
    "SECURITY.md",
    "TRADEMARKS.md",
    "dist",
    "docs/cockpit.md",
    "docs/commands.md",
    "docs/configuration.md",
    "docs/development.md",
    "docs/mcp.md",
    "docs/quickstart.md",
    "docs/workflows.md",
    "templates"
  ],
  "scripts": {
    "build": "tsup",
    "test": "pnpm build && vitest run",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.3.0",
  "dependencies": {
    "commander": "^12.1.0",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "visp-kit": ">=0.2.3 <0.5.0"
  },
  "peerDependenciesMeta": {
    "visp-kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/djkeshawa/visp-hyper-agent.git"
  }
}
